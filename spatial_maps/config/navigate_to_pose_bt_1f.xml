<!--
  Simplified navigate_to_pose BT for the hospital sweep.

  Key differences from the Nav2 default:
  - number_of_retries="1"  (was 6) — try one recovery round then FAIL fast
  - Spin has time_allowance="8.0" — caps spin at 8 sim-s; without this the
    Spin action runs forever when the robot is wedged in a tight space
  - Wait removed — we want the sweep to move on, not sit idle
-->
  <!-- 1F variant: replanning every 5 s, not every 1 s. The Smac State Lattice
       planner takes about 4 s for a floor-length plan on the 0.05 m costmap,
       and the map is static, so 1 Hz replanning only stalls the tree. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="0.2">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <!-- No WouldA*RecoveryHelp gate on 1F: those conditions report that recovery
             cannot help a "Start occupied" planner failure, so the tree aborted in
             0.0 s and left the robot parked in a pose it could never plan out of,
             failing 83 of 94 goals. Backing up does free it, so always try. -->
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" time_allowance="8.0" error_code_id="{spin_error_code}"/>
            <!-- Reversing frees a robot parked too close to a wall for the planner to
                 accept its start pose; spinning in place cannot. -->
            <BackUp backup_dist="0.30" backup_speed="0.10" time_allowance="10.0" error_code_id="{backup_error_code}"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
