<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="cbnu_scan">

    <!-- Gz Sim required plugins -->
    <!-- Bullet Featherstone handles static mesh collision via BVH; DART crashed on the earlier 17k-face mesh -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
      <engine>
        <filename>gz-physics7-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Physics settings -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional light (replaces model://sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- CBNU scan-derived map. Generated by tools/cbnu_scan/build_site.py, do not edit. -->
    <!-- The walls are the outline of the occupied cells of maps/CBNU_scan.pgm, so this world -->
    <!-- is the map by construction. It tests the navigation stack on the map and says     -->
    <!-- nothing about how well the map matches the building.                              -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>82.55 38.85</size></plane></geometry>
          <surface>
            <friction>
              <!-- Bullet Featherstone needs torsional 0 here or the robot cannot yaw (CLAUDE.md). -->
              <torsional><coefficient>0</coefficient></torsional>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>82.55 38.85</size></plane></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
      <pose>-36.484 -9.194 -0.01 0 0 0</pose>
    </model>
    <model name="cbnu_scan_walls">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>file:///home/jason/ros2_ws/src/spatial_maps/meshes/cbnu_scan_walls.obj</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>file:///home/jason/ros2_ws/src/spatial_maps/meshes/cbnu_scan_walls.obj</uri></mesh></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>
    <!-- Invisible perimeter fence 1 m outside each map edge, as on 1F. -->
    <model name="fence_west"><static>true</static><link name="link"><collision name="col"><geometry><box><size>0.20 41.25 3.0</size></box></geometry></collision></link><pose>-78.759 -9.194 1.5 0 0 0</pose></model>
    <model name="fence_east"><static>true</static><link name="link"><collision name="col"><geometry><box><size>0.20 41.25 3.0</size></box></geometry></collision></link><pose>5.791 -9.194 1.5 0 0 0</pose></model>
    <model name="fence_south"><static>true</static><link name="link"><collision name="col"><geometry><box><size>84.95 0.20 3.0</size></box></geometry></collision></link><pose>-36.484 -29.619 1.5 0 0 0</pose></model>
    <model name="fence_north"><static>true</static><link name="link"><collision name="col"><geometry><box><size>84.95 0.20 3.0</size></box></geometry></collision></link><pose>-36.484 11.231 1.5 0 0 0</pose></model>
  </world>
</sdf>
