<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="1f">

    <!-- Gz Sim required plugins -->
    <!-- Bullet Featherstone handles static mesh collision via BVH; DART crashed on the earlier 17k-face mesh -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
      <engine>
        <filename>gz-physics7-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Physics settings -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional light (replaces model://sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor plan ground plane — textured with 1F occupancy map -->
    <!-- Map: origin=(0.9107,-2.0), size=41.5x79.64m, center=(21.6607,37.82) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>41.5 79.64</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>41.5 79.64</size>
            </plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/jason/ros2_ws/src/spatial_maps/maps/1F_map_orig.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
      <pose>21.6607 37.82 -0.01 0 0 0</pose>
    </model>

    <!-- Hospital 1F walls: IfcWall + IfcColumn from the pipeline floor_1F.glb, visual and    -->
    <!-- collision. Generated by scripts/glb_to_wall_mesh.py in the same UCS frame as 1F.pgm, -->
    <!-- so there is no XY offset (100% of wall slice samples within 3 px of occupied cells). -->
    <!-- Mesh X=0.10-40.40, Y=0-75.62, wall base at model Z=0.                               -->
    <!-- Replaces the 1108 PGM-derived boxes (models/pgm_walls_1f). Non-structural PGM        -->
    <!-- obstacles (no IfcWall/IfcColumn) are in the costmap but have no collision.           -->
    <model name="hospital_1f_walls">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/jason/ros2_ws/src/spatial_maps/meshes/floor_1F_walls_only.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/jason/ros2_ws/src/spatial_maps/meshes/floor_1F_walls_only.obj</uri>
            </mesh>
          </geometry>
          <!-- Material is driven by floor_1F_walls_only.mtl (grey_wall) -->
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <!-- Identity XY pose: the mesh is already in map coordinates. tz=-0.05 sinks the base -->
      <!-- slightly below the floor plane to avoid a visible seam.                           -->
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- Invisible perimeter fence: collision-only walls 1 m outside each PGM map edge.     -->
    <!-- Map edges: x=0.91..42.41, y=−2.0..77.64 → fence at x=−0.1/43.4, y=−3.0/78.6.   -->
    <!-- Prevents the robot from physically escaping the map area through any gap.            -->
    <!-- No visual element = invisible in Gazebo. LiDAR may see them at map edges (harmless  -->
    <!-- since costmaps are static-layer only; no obstacle_layer).                           -->
    <model name="fence_west">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 82.0 3.0</size></box></geometry>
        </collision>
      </link>
      <pose>-0.1 37.8 1.5 0 0 0</pose>
    </model>
    <model name="fence_east">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 82.0 3.0</size></box></geometry>
        </collision>
      </link>
      <pose>43.4 37.8 1.5 0 0 0</pose>
    </model>
    <model name="fence_south">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><box><size>44.0 0.2 3.0</size></box></geometry>
        </collision>
      </link>
      <pose>21.65 -3.0 1.5 0 0 0</pose>
    </model>
    <model name="fence_north">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><box><size>44.0 0.2 3.0</size></box></geometry>
        </collision>
      </link>
      <pose>21.65 78.6 1.5 0 0 0</pose>
    </model>

    <!-- The 1108 PGM-derived collision boxes (model://pgm_walls_1f, generated by     -->
    <!-- pgm_to_sdf_walls.py) are no longer included: hospital_1f_walls above carries -->
    <!-- collision. To restore them, add <include><uri>model://pgm_walls_1f</uri>     -->
    <!-- </include> here; GZ_SIM_RESOURCE_PATH is still set by the launch file.       -->

  </world>
</sdf>
